# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Public URL the app is served at (no trailing slash). Used to bake the web build's
# API URL and to set CORS.
PUBLIC_URL=https://studio.example.com

# Caddy site address. A bare domain turns on automatic HTTPS (Let's Encrypt).
# For a local trial without a domain, use:  SITE_ADDRESS=:80  and PUBLIC_URL=http://localhost
SITE_ADDRESS=studio.example.com

# HTTP Basic Auth that guards the WHOLE site (web + API) — Agent Studio has no auth
# of its own. Generate the bcrypt hash (quote the password to keep special chars):
#   docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-strong-password'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=REPLACE_WITH_BCRYPT_HASH

# Host directory holding ALL persistent state (db, projects, secrets, build cache).
# docker-compose bind-mounts it at the same path inside the API container, which the
# sandbox relies on. DATABASE_URL below must point inside it.
ATELIER_DATA_DIR=/srv/atelier
DATABASE_URL=sqlite:////srv/atelier/db/atelier.db
# To use Postgres instead (single instance only — the app holds a process-wide lock):
# DATABASE_URL=postgresql+psycopg://atelier:password@db:5432/atelier

# Optional provider/integration keys. These can also be set in the UI
# (Settings -> Providers), which stores them encrypted at rest.
OPENAI_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
