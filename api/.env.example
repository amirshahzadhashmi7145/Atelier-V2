# The browser never receives these values. Prefer Settings > Providers (encrypted at rest).
# Env vars remain a fallback. Do not commit real keys.
#
# Model providers (LiteLLM gateway; agent model.provider is data):
# - OpenAI: OPENAI_API_KEY or a key saved in Settings
# - Gemini: GEMINI_API_KEY (or GOOGLE_API_KEY) or a key saved in Settings
#
OPENAI_API_KEY=
# GEMINI_API_KEY=   (or GOOGLE_API_KEY from AI Studio)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TOOL_CHOICE=required
# RUN_MAX_OUTPUT_TOKENS=4096
# GATEWAY_MOCK=1
PROJECTS_DIR=
GITHUB_TOKEN=
# Comma-separated; include both localhost and 127.0.0.1 if you mix URLs in dev.
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
