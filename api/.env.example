# The browser never receives these values.
#
# Model providers (same run loop; agent model.provider picks openai | gemini | ollama):
# - OpenAI: OPENAI_API_KEY, agent model provider "openai"
# - Gemini: GEMINI_API_KEY, agent model provider "gemini" (google-genai in gateway only)
# - Ollama: OLLAMA_BASE_URL + OLLAMA_MODEL, agent model provider "ollama"
# Default gateway when agent provider is omitted: Ollama if OLLAMA_BASE_URL set, else Gemini if GEMINI_API_KEY, else OpenAI.
#
OPENAI_API_KEY=
# GEMINI_API_KEY=   (or GOOGLE_API_KEY from AI Studio)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TOOL_CHOICE=required
# RUN_MAX_OUTPUT_TOKENS=4096
# GATEWAY_MOCK=1
PROJECTS_DIR=
GITHUB_TOKEN=
# Comma-separated; include both localhost and 127.0.0.1 if you mix URLs in dev.
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
